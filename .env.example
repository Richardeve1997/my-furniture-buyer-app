# Copy this file to .env and fill in the values. .env is never committed.

# Local database (SQLite file).
DATABASE_URL="file:./dev.db"

# Encrypts the login cookie. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Shared, read-only catalogue database published in the Day 1 lab materials
# (Step 2 / Step 4). Shared across every team, but still kept out of source.
MONGODB_URI=""

# --- Filled in at Lab 2, once an organiser provides them ---
# The furniture-shop API root.
API_BASE_URL=""
# Your personal key. Treat like a password — it can spend your balance.
API_KEY=""
# Your assigned user, e.g. u001. Must match the key.
API_USER_ID=""
